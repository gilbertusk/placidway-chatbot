# Copy to .env for local runs. On Hugging Face Spaces set these under Settings > Variables and secrets.

# Required: Google AI Studio API key (keep it secret)
GEMINI_API_KEY=

# Required for the admin panel (refresh content, unanswered questions). Any long random string.
ADMIN_TOKEN=

# Optional overrides
# GEMINI_ANSWER_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=LOW
# GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# CRAWLER_CONTACT=you@example.com
# TOP_K=6
